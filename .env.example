# 异步数据库连接 — FastAPI使用（aiomysql驱动）
DATABASE_URL=mysql+aiomysql://root:password@localhost:3306/student_management
# 同步数据库连接 — 命令行脚本使用（pymysql驱动）
SYNC_DATABASE_URL=mysql+pymysql://root:password@localhost:3306/student_management
# JWT认证密钥 — 生产环境务必设为随机字符串，无默认值则启动失败
SECRET_KEY=your-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
# CORS — 逗号分隔的前端来源，开发环境设为 * 允许所有
ALLOWED_ORIGINS=http://localhost:5175
# SQL调试 — true打印SQL（开发用），false关闭（生产用）
DEBUG_SQL=true
# ===== 智能体助手（Ollama 本地模型）=====
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_TIMEOUT=10
OLLAMA_MAX_CONCURRENCY=4
AGENT_CONFIRM_TTL=300
AGENT_SESSION_TTL=1800
AGENT_SESSION_LIMIT=20
CONTEXT_BUDGET_TOKENS=8000
