# Docker 环境变量
# 用于本地开发 — docker-compose up 时自动加载

# 数据库（容器内使用 db 服务名）
DATABASE_URL=mysql+aiomysql://root:password@db:3306/student_management
SYNC_DATABASE_URL=mysql+pymysql://root:password@db:3306/student_management

# JWT — 注意：SECRET_KEY 不在本文件设置，必须由宿主机环境变量注入
# （docker-compose.yml 使用 ${SECRET_KEY:?} 强制要求，未设置则启动失败）
# 生成方式：python -c "import secrets; print(secrets.token_urlsafe(48))"
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# CORS
ALLOWED_ORIGINS=http://localhost,http://127.0.0.1

# SQL 调试（生产环境关）
DEBUG_SQL=false

# 智能体（Ollama 运行在宿主机；容器内通过 host.docker.internal 访问）
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen2.5:7b
