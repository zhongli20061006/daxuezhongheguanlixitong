# Docker 环境变量
# 用于本地开发 — docker-compose up 时自动加载

# 数据库（容器内使用 db 服务名）
DATABASE_URL=mysql+aiomysql://root:password@db:3306/student_management
SYNC_DATABASE_URL=mysql+pymysql://root:password@db:3306/student_management

# JWT
SECRET_KEY=change-me-in-production-use-random-64-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# CORS
ALLOWED_ORIGINS=http://localhost,http://127.0.0.1

# SQL 调试（生产环境关）
DEBUG_SQL=false
